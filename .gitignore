/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/next-env.d.ts
*.tsbuildinfo

# Test coverage and local deployment state
/frontend/coverage/
/frontend/.vercel/

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# macOS metadata
.DS_Store
