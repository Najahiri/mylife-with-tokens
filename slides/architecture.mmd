        A4 --> A5[Metadata<br/>Enrichment]
    end

    subgraph IDX["02 · INDEX"]
        direction TB
        B1[Dense<br/>Embeddings] --> B2[(Vector Store)]
        B3[BM25<br/>Sparse Index] --> B4[(Keyword Store)]
        B2 --> B5{{Fusion<br/>Layer}}
        B4 --> B5
    end

    subgraph RET["03 · RETRIEVE"]
        direction TB
        C1([User Query]) --> C2[Query<br/>Rewriter]
